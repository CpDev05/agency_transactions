# Puerto del servidor Express
PORT=4000

# Interfaz de escucha. 0.0.0.0 permite conexiones externas (necesario en Docker);
# para restringir a local puedes usar 127.0.0.1.
HOST=0.0.0.0

# Entorno: development | test | production
NODE_ENV=development

# Cadena de conexión a MongoDB
# (local: mongodb://localhost:27017/agency_transactions | Docker: mongodb://mongo:27017/agency_transactions)
MONGODB_URI=mongodb://localhost:27017/agency_transactions

# Secreto para firmar los JWT (obligatorio). Genera uno propio:
#   openssl rand -hex 32
# Debe tener al menos 32 caracteres. Este valor de ejemplo es inválido a
# propósito: el servidor no arrancará hasta que pongas uno real.
JWT_SECRET=cambia-este-secreto

# Duración explícita del access token (unidad obligatoria: s, m, h, d o w)
JWT_EXPIRES_IN=1h

# Origen permitido del frontend (opcional). En producción, si no se define,
# no se habilitan cabeceras CORS (solo mismo origen).
CORS_ORIGIN=http://localhost:5173

# Límite de intentos de login por IP (opcionales):
# máximo de peticiones y ventana en milisegundos. Por defecto: 10 / 15 min.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
